# ============================================================
# .htaccess — EntraID Threat Intelligence Platform
# Versión compatible con hosting compartido
# ============================================================

# Desactivar listado de directorios (compatible con la mayoría de hostings)
Options -Indexes

# Ocultar firma del servidor
ServerSignature Off

# ============================================================
# PROTECCIÓN DE ARCHIVOS SENSIBLES
# ============================================================

# Bloquear acceso a archivos que empiezan con punto (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Bloquear archivos de configuración y datos
<FilesMatch "\.(env|ini|log|sqlite|db|bak|backup|old|sql|json)$">
    Require all denied
</FilesMatch>

# Bloquear acceso directo a directorios internos
# (usamos RedirectMatch 404 en lugar de 403 para no revelar estructura)
# IMPORTANTE: el patrón DEBE ir anclado con ^. RedirectMatch sin ancla coincide
# en cualquier parte de la URL y bloquearía rutas de la app como
# /index.php/modules/reports (contienen "/modules/").
RedirectMatch 404 ^/config/
RedirectMatch 404 ^/includes/
RedirectMatch 404 ^/modules/
RedirectMatch 404 ^/storage/
RedirectMatch 404 ^/cron/
RedirectMatch 404 ^/views/

# ============================================================
# PHP CONFIGURATION (solo si el hosting lo permite)
# Si da error 500, comenta estas líneas
# ============================================================

# Error handling
php_flag display_errors Off
php_flag log_errors On

# Memoria y tiempo (valores conservadores para hosting compartido)
php_value memory_limit 256M
php_value max_execution_time 120

# ============================================================
# HEADERS DE SEGURIDAD (solo si mod_headers disponible)
# ============================================================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS: obliga al navegador a usar HTTPS durante 1 año
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ============================================================
# REWRITE ENGINE
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS (HTTP -> HTTPS). Respeta proxies/CDN que ya indican https.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Detectar RewriteBase automáticamente
    # Comenta la siguiente línea si sabes la ruta base exacta
    # RewriteBase /

    # Si el archivo o directorio existe, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirigir /api/* a api/index.php
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]

    # Redirigir /admin/* a admin/index.php (si no es un archivo real)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^admin/(.*)$ admin/index.php [QSA,L]

    # Todo lo demás va a index.php (front controller)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ============================================================
# CHARSET Y COMPRESIÓN
# ============================================================

AddDefaultCharset UTF-8

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# ============================================================
# CACHE DE ASSETS ESTÁTICOS
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/svg+xml "access plus 1 week"
</IfModule>
