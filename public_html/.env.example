# ============================================================
# .env.example — Plantilla de configuración
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Aplicación ---
APP_NAME="EntraID Threat Intelligence"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://graph.cibersecurity.io
APP_TIMEZONE=Europe/Madrid

# --- Servidor ---
# Si tu hosting NO tiene mod_rewrite, pon esto a true.
# Las URLs usarán /admin/index.php/login en lugar de /admin/login
FORCE_NO_REWRITE=false

# --- Seguridad ---
# Clave maestra de cifrado (32 bytes, base64). Genera con:
#   php -r "echo base64_encode(random_bytes(32));"
# Esta clave cifra los secretos de los tenants en la BD.
# NUNCA compartas ni pierdas esta clave.
ENCRYPTION_KEY=

# Clave para firmar sesiones y tokens CSRF (32 bytes, hex)
SESSION_SECRET=

# --- Base de datos ---
DB_PATH=storage/database.sqlite

# --- LLM (opcional) ---
# Proveedor: openai | anthropic | ollama | azure
LLM_PROVIDER=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_MAX_TOKENS=2048

# --- Cron / Sincronización ---
# Token secreto para llamar a cron/sync.php vía web
CRON_TOKEN=
CRON_SYNC_INTERVAL=3600
