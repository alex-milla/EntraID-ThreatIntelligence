# ============================================================
# .env.example — Plantilla de configuración
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Aplicación ---
APP_NAME="EntraID Threat Intelligence"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://graph.cibersecurity.io
APP_TIMEZONE=Europe/Madrid

# --- Servidor ---
# Si tu hosting NO tiene mod_rewrite, pon esto a true.
# Las URLs usarán /admin/index.php/login en lugar de /admin/login
FORCE_NO_REWRITE=false

# --- Seguridad ---
# Clave maestra de cifrado (32 bytes, base64). Genera con:
#   php -r "echo base64_encode(random_bytes(32));"
# Esta clave cifra los secretos de los tenants en la BD.
# NUNCA compartas ni pierdas esta clave.
ENCRYPTION_KEY=

# Clave para firmar sesiones y tokens CSRF (32 bytes, hex)
SESSION_SECRET=

# --- Base de datos ---
DB_PATH=storage/database.sqlite

# --- Catálogo público de CVEs (opcional) ---
# Base de datos independiente para NVD/KEV/EPSS e inventario de software.
CVE_DB_PATH=storage/cve.sqlite
# API key gratuita de NVD (recomendada): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Sonda de novedades antes de sincronizar (1 = activada): evita descargar el
# catálogo cuando no hay ningún CVE modificado desde la última sincronización.
CVE_PROBE=1
# Lo mismo para Threat Intelligence: 1 petición a Graph antes de sincronizar;
# si no hay artículos nuevos o modificados, no se crea el job.
TI_PROBE=1

# --- ThreatFox (abuse.ch) — IOCs ---
# Auth-Key gratuita: https://auth.abuse.ch/
# Si se define aquí tiene prioridad sobre la que se guarde desde la UI.
THREATFOX_AUTH_KEY=
# Base independiente de IOCs (por defecto storage/threatfox.sqlite).
THREATFOX_DB_PATH=storage/threatfox.sqlite
# Solo para pruebas: apuntar la API o el export a un mock local.
# THREATFOX_API_URL=http://127.0.0.1:8000/api/v1/
# THREATFOX_EXPORT_URL=

# --- LLM (opcional) ---
# Proveedor: openai | anthropic | ollama | azure
LLM_PROVIDER=
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_MAX_TOKENS=2048

# --- Cron / Sincronización ---
# Token secreto para llamar a cron/sync.php o cron/cve-sync.php vía web
CRON_TOKEN=
CRON_SYNC_INTERVAL=3600
